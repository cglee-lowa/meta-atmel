#!/bin/sh
AUTOLOGIN=$(cat /lib/systemd/system/serial-getty@.service | grep '\-a root')
if [ -z "$AUTOLOGIN" ]; then
    echo "Set Auto Login"
    sed -i -e 's/^\(ExecStart *=.*getty \)/\1-a root /' /lib/systemd/system/serial-getty@.service
fi
BASHRC=$(cat /etc/profile | grep '~/.bashrc')
if [ -z "$BASHRC" ]; then
    echo -e "\n~/.bashrc" >> /etc/profile
fi

P2SIZE=$(fdisk -l | grep /dev/mmcblk0p2 | awk '{print $3}')
#echo $P2SIZE
if [ "$P2SIZE" -le  2000000 ]; then
    echo "eMMC Need Resize"
    (
     echo d
     echo 2
     echo n
     echo p
     echo 2
     echo 42608
     echo
     echo n
     echo w
     echo q
     ) | fdisk /dev/mmcblk0;
     resize2fs /dev/mmcblk0p2;
     reboot;
     exit 0
fi

fallocate -l 1G /swapfile
chmod 600 /swapfile
mkswap /swapfile
swapon /swapfile
exit 0